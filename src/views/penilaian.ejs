<h2 class="mb-4">Matriks Penilaian</h2>

<div class="alert alert-info">
    Silakan isi nilai untuk semua alternatif pada form di bawah ini, lalu klik <b>Simpan Semua Nilai</b>.
</div>

<form action="/penilaian/simpan" method="POST">
    <div class="table-responsive">
        <table class="table table-bordered align-middle table-hover">
            <thead class="table-dark text-center">
                <tr>
                    <th width="20%">Nama Alternatif</th>
                    
                    <% kriteria.forEach(k => { %>
                        <th>
                            <%= k.nama %> <br> 
                            <small class="badge bg-<%= k.tipe.toLowerCase() === 'benefit' ? 'success' : 'danger' %> mt-1">
                                <%= k.tipe %>
                            </small>
                        </th>
                    <% }) %>
                    
                    <th width="10%">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if(alternatif.length > 0 && kriteria.length > 0) { %>
                    <% alternatif.forEach(a => { %>
                        <tr>
                            <td class="fw-bold"><%= a.nama %></td>
                            
                            <% kriteria.forEach(k => { %>
                                <% let nilaiSkg = a.Penilaians.find(p => p.id_kriteria === k.id); %>
                                
                                <td>
                                    <input type="number" 
                                           min="0" 
                                           max="5" 
                                           step="1" 
                                           name="nilai_<%= a.id %>_<%= k.id %>" 
                                           class="form-control text-center" 
                                           value="<%= nilaiSkg ? nilaiSkg.nilai : '' %>" 
                                           placeholder="0" 
                                           required>
                                </td>
                            <% }) %>
                            
                            <td class="text-center align-middle">
                                <a href="/penilaian/hapus/<%= a.id %>" 
                                   class="btn btn-sm btn-danger" 
                                   onclick="return confirm('Yakin ingin mereset semua nilai untuk <%= a.nama %>?');"
                                   title="Reset Nilai">
                                    <i class="bi bi-trash"></i> Hapus
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="<%= kriteria.length + 2 %>" class="text-center">
                            Data Kriteria atau Alternatif belum lengkap.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between mt-4 mb-5">
        <a href="/alternatif" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i> Kembali</a>
        <div>
            <button type="submit" class="btn btn-success me-2"><i class="bi bi-save me-2"></i> Simpan Semua Nilai</button>
            <a href="/hasil" class="btn btn-warning shadow text-dark fw-bold">Lihat Hasil Ranking <i class="bi bi-trophy-fill ms-2"></i></a>
        </div>
    </div>
</form>

<script>
    // Trik javascript agar saat tombol ditekan, browser tidak kembali ke atas layar
    window.addEventListener('beforeunload', () => {
        localStorage.setItem('scrollPosition', window.scrollY);
    });
    window.addEventListener('load', () => {
        const scrollPosition = localStorage.getItem('scrollPosition');
        if (scrollPosition !== null) {
            window.scrollTo(0, parseInt(scrollPosition, 10));
            localStorage.removeItem('scrollPosition');
        }
    });
</script>