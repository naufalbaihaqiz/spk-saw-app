<h2>Tambah Data Alternatif</h2>
<hr>
<form action="/alternatif/tambah" method="POST" class="w-50">
    <div class="mb-3">
        <label class="form-label">Nama Alternatif</label>
        <input type="text" name="nama" class="form-control" required placeholder="Masukkan nama alternatif...">
    </div>
    <button type="submit" class="btn btn-success">Simpan</button>
    <a href="/alternatif" class="btn btn-secondary">Batal</a>
</form>