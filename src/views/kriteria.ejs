<%# ========================================================================= %>
<%# 1. HEADER & TOMBOL TAMBAH %>
<%# Bagian atas halaman yang berisi judul dan tombol untuk menuju form tambah data. %>
<%# ========================================================================= %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Data Kriteria</h2>
    <a href="/kriteria/tambah" class="btn btn-primary">+ Tambah Kriteria</a>
</div>

<%# ========================================================================= %>
<%# 2. PERINGATAN (ALERT) TOTAL BOBOT %>
<%# Mengecek nilai 'totalBobot' yang dikirim dari KriteriaController. %>
<%# Memunculkan warna kuning jika < 1.0, dan hijau jika sudah pas 1.0. %>
<%# ========================================================================= %>
<% if (typeof totalBobot !== 'undefined') { %>
    <% if (totalBobot < 1.0) { %>
        <div class="alert alert-warning mb-4 shadow-sm">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <b>Perhatian:</b> Total bobot kriteria saat ini baru <b><%= totalBobot %></b>.
            Silakan tambah kriteria lagi agar totalnya pas <b>1.0</b>.
        </div>
    <% } else if (totalBobot === 1.0) { %>
        <div class="alert alert-success mb-4 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>
            Total bobot kriteria sudah pas <b>1.0</b>. Sistem siap untuk perhitungan SAW!
        </div>
    <% } %>
<% } %>

<%# ========================================================================= %>
<%# 3. TABEL DATA KRITERIA %>
<%# Menampilkan daftar kriteria dari database dalam bentuk tabel terstruktur. %>
<%# ========================================================================= %>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th width="5%">No</th>
            <th>Nama Kriteria</th>
            <th>Bobot</th>
            <th>Atribut (Tipe)</th>
            <th width="15%">Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% if(data.length > 0) { %>
            <% data.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= item.nama %></td>
                    <td><%= item.bobot %></td>
                    <td>
                        <span class="badge bg-<%= item.tipe.toLowerCase() === 'benefit' ? 'success' : 'danger' %>">
                            <%= item.tipe.toUpperCase() %>
                        </span>
                    </td>
                    <td>
                        <a href="/kriteria/hapus/<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Yakin ingin menghapus?')">Hapus</a>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr><td colspan="5" class="text-center">Belum ada data kriteria</td></tr>
        <% } %>
    </tbody>
</table>

<%# ========================================================================= %>
<%# 4. NAVIGASI BAWAH %>
<%# Tombol pemandu langkah pengguna untuk mundur atau lanjut ke tahap berikutnya. %>
<%# ========================================================================= %>
<div class="d-flex justify-content-between mt-5">
    <a href="/dashboard" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i> Kembali</a>
    <a href="/alternatif" class="btn btn-primary">Lanjut ke Data Alternatif <i class="bi bi-arrow-right ms-2"></i></a>
</div>