<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Data Alternatif</h2>
    <a href="/alternatif/tambah" class="btn btn-primary">+ Tambah Alternatif</a>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th width="5%">No</th>
            <th>Nama Alternatif</th>
            <th width="15%">Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% if(data.length > 0) { %>
            <% data.forEach((item, index) => { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td><%= item.nama %></td>
                    <td>
                        <a href="/alternatif/hapus/<%= item.id %>" class="btn btn-danger btn-sm" onclick="return confirm('Yakin ingin menghapus data ini?')">Hapus</a>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr><td colspan="3" class="text-center">Belum ada data alternatif</td></tr>
        <% } %>
    </tbody>
</table>
<div class="d-flex justify-content-between mt-5">
    <a href="/kriteria" class="btn btn-secondary"><i class="bi bi-arrow-left me-2"></i> Kembali</a>
    <a href="/penilaian" class="btn btn-primary">Lanjut ke Penilaian <i class="bi bi-arrow-right ms-2"></i></a>
</div>