<h2>Tambah Data Kriteria</h2>
<hr>
<form action="/kriteria/tambah" method="POST" class="w-50">
    <div class="mb-3">
        <label class="form-label">Nama Kriteria</label>
        <input type="text" name="nama" class="form-control" required placeholder="Contoh: Harga, Kualitas...">
    </div>
    <div class="mb-3">
        <label class="form-label">Bobot</label>
        <input type="number" step="0.01" name="bobot" class="form-control" required placeholder="Contoh: 0.25">
    </div>
    <div class="mb-3">
        <label class="form-label">Tipe (Atribut)</label>
        <select name="tipe" class="form-select" required>
            <option value="benefit">Benefit (Semakin besar semakin baik)</option>
            <option value="cost">Cost (Semakin kecil semakin baik)</option>
        </select>
    </div>
    <button type="submit" class="btn btn-success">Simpan</button>
    <a href="/kriteria" class="btn btn-secondary">Batal</a>
</form>